# ==============================================================================
# Faculty Feedback & Intelligence Portal — Backend Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME="Faculty Feedback Portal"

# Frontend Integration & CORS (Comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (MongoDB Atlas or local replica set)
MONGODB_URI=mongodb://localhost:27017/faculty_feedback
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# Authentication & Session Security
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_cookie_signing_secret_at_least_32_chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ENABLE_PASSWORD_AUTH=true

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
# Institutional domain restrictions (comma-separated, leave blank to allow any Google account in dev)
ALLOWED_EMAIL_DOMAINS=

# OpenAI API Configuration (Server-side evaluation & report synthesis)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2500
OPENAI_TEMPERATURE=0.2

# Email Service (Nodemailer SMTP or transactional provider)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM="Faculty Intelligence Portal <noreply@institution.edu>"
EMAIL_REPLY_TO="support@institution.edu"
# Set to true to mock sending emails in development without an active SMTP server
EMAIL_MOCK_ENABLED=true

# Persistent Job Queue & Cache (Redis & BullMQ)
REDIS_URL=redis://127.0.0.1:6379
# If Redis is unavailable in local dev, queueManager uses built-in persistent MongoDB queue fallback
QUEUE_CONCURRENCY=5

# Scheduled Reminders & Escalation Policies
DEFAULT_TIMEZONE=UTC
REMINDER_SCHEDULE_HOURS_1=48
REMINDER_SCHEDULE_HOURS_2=96
ESCALATION_SCHEDULE_HOURS=120
SCHEDULER_RECONCILIATION_INTERVAL_MS=300000

# Faculty AI Reports & Anonymity Thresholds
MIN_REPORT_RESPONSES=5
REPORT_STORAGE_PATH=./storage/reports

# Logging & Observability
LOG_LEVEL=info
